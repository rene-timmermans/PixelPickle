[Desktop Entry]
Type=Application
Name=PixelPickle
GenericName=Fotobewerker
Comment=Fotobewerker voor Linux met een begrijpelijke en vertrouwde indeling van de gereedschappen
Exec=pixelpickle %F
Icon=pixelpickle
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
MimeType=image/png;image/jpeg;image/bmp;image/tiff;image/webp;image/gif;image/x-tga;image/openraster;
Keywords=foto;afbeelding;bewerken;lagen;psp;
StartupWMClass=pixelpickle
